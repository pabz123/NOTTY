{
  "name": "accountability-system",
  "version": "1.0.0",
  "description": "Desktop Accountability Management System",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-windows": "electron-builder --windows",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.accountability.app",
    "productName": "Accountability System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "run.js",
      "frontend/**/*",
      "*.py",
      "requirements.txt",
      "config.py",
      "auth.py",
      "database.py",
      "models.py",
      "schemas.py",
      "events.py",
      "scheduler.py",
      "email_service.py",
      "activities.db",
      "icon.png",
      "icon.ico",
      "!__pycache__",
      "!venv",
      "!.venv",
      "!.git"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Accountability System"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0",
    "js": "^0.1.0",
    "node": "^25.4.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "keywords": [
    "productivity",
    "accountability",
    "task-management",
    "electron"
  ],
  "author": "Your Name",
  "license": "MIT"
}
